<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="main.ImportZipController"
            prefWidth="1000" prefHeight="700">
    <padding>
        <Insets topRightBottomLeft="10"/>
    </padding>

    <top>
        <VBox spacing="10">

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Zip File to import :"/>
                <TextField fx:id="zipPathField" HBox.hgrow="ALWAYS"/>
                <Button fx:id="browseButton" text="X" onAction="#onBrowse"/>
            </HBox>

            <Label text="WARNING : replacing any existing item (with a imported one with the same name) will erase the currently saved version"
                   textFill="DARKRED" maxWidth="Infinity" alignment="CENTER">
                <padding>
                    <Insets bottom="10"/>
                </padding>
            </Label>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.5">
            <padding>
                <Insets top="5" bottom="5"/>
            </padding>

            <!-- Panneau gauche -->
            <VBox spacing="5">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <padding>
                        <Insets left="10" right="10"/>
                    </padding>
                    <Label text="Artifacts to import (in red if name is already in use)"
                           HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="replaceAllArtifactsButton" text="Replace all"
                            onAction="#onReplaceAllArtifacts"/>
                    <Button fx:id="renameButton" text="Rename" onAction="#onRename"/>
                </HBox>
                <TreeView fx:id="artifactsTree" showRoot="false" VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- Panneau droit -->
            <VBox spacing="5">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <padding>
                        <Insets left="10" right="10"/>
                    </padding>
                    <Label text="Existing images (click to compare):"
                           HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="replaceAllImagesButton" text="Replace all"
                            onAction="#onReplaceAllImages"/>
                </HBox>
                <StackPane VBox.vgrow="ALWAYS">
                    <TreeView fx:id="existingImagesTree" showRoot="false"/>
                    <Label fx:id="noDuplicateLabel" text="No duplicate images"
                           mouseTransparent="true"/>
                </StackPane>
            </VBox>
        </SplitPane>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" bottom="10"/>
            </padding>
            <ProgressBar fx:id="progressBar" progress="0.0"
                         maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button fx:id="importButton" text="Import" onAction="#onImport"/>
            <Button fx:id="closeButton" text="Close" onAction="#onClose" cancelButton="true"/>
        </HBox>
    </bottom>
</BorderPane>